<Window x:Class="PocketDrop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PocketDrop.Core"
        Title="PocketDrop" Width="600" Height="760" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        Icon="pack://application:,,,/PocketDrop;component/Assets/app.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,12">

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/PocketDrop;component/Assets/app.png" Width="48" Height="48" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PocketDrop" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" FontSize="13" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Update available -->
            <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Background="#EEF5FF" BorderBrush="{StaticResource Accent}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="UpdateTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock x:Name="UpdateHint" Style="{StaticResource Hint}" />
                        <ProgressBar x:Name="UpdateProgress" Style="{StaticResource PopupProgress}" Background="#D6E6FA"
                                     Maximum="100" Margin="0,8,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="UpdateError" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="UpdateButton" Grid.Column="1" Content="{core:T update.button}" Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center" Padding="22,9" Click="OnUpdate" />
                </Grid>
            </Border>

            <!-- This PC -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{core:T section.pc}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{core:T pc.name}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <TextBox x:Name="NameBox" LostFocus="OnNameChanged" MaxLength="40" />
                    <TextBlock Text="{core:T pc.address}" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                    <TextBlock x:Name="AddressText" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
            </Border>

            <!-- Receive folder -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{core:T section.folder}" Style="{StaticResource CardTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FolderText" FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Button Grid.Column="1" Content="{core:T folder.open}" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Click="OnOpenFolder" />
                        <Button Grid.Column="2" Content="{core:T folder.change}" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Click="OnChangeFolder" />
                    </Grid>
                    <TextBlock Text="{core:T folder.hint}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Wi-Fi -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{core:T section.wifi}" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="WifiBox" Content="{core:T wifi.enable}" Click="OnWifiToggled" />
                    <TextBlock Text="{core:T wifi.hint}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <TextBlock x:Name="WifiError" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Browser / iPhone -->
            <Border x:Name="BrowserCard" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{core:T section.browser}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{core:T browser.hint}" Style="{StaticResource Hint}" />
                        <TextBlock x:Name="UrlText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                   Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="OnUrlClick" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="6"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <Image x:Name="QrImage" Width="150" Height="150" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </Grid>
            </Border>

            <!-- From anywhere (Cloudflare tunnel) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{core:T section.remote}" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="RemoteBox" Content="{core:T remote.enable}" Click="OnRemoteToggled" />
                    <TextBlock Text="{core:T remote.hint}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <Grid x:Name="RemotePanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="RemoteStatus" FontSize="13" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                            <ProgressBar x:Name="RemoteProgress" Style="{StaticResource PopupProgress}" Maximum="100" Margin="0,8,0,0"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="RemoteLink" FontSize="12.5" Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="OnCopyRemote" Visibility="Collapsed" />
                            <StackPanel x:Name="RemoteButtons" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button x:Name="CopyRemoteButton" Content="{core:T remote.copy}" Style="{StaticResource SecondaryButton}"
                                        Click="OnCopyRemote" />
                                <Button Content="{core:T remote.newLink}" ToolTip="{core:T remote.newLinkTip}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Click="OnNewRemoteLink" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="RemoteQrBorder" Grid.Column="1" Background="White" CornerRadius="8" Padding="6" VerticalAlignment="Top"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Visibility="Collapsed">
                            <Image x:Name="RemoteQr" Width="150" Height="150" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bluetooth -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{core:T section.bt}" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="BtBox" Content="{core:T bt.enable}" Click="OnBluetoothToggled" />
                    <TextBlock x:Name="BtStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <TextBlock Text="{core:T bt.hint}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <Button Content="{core:T bt.settings}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="OnBluetoothSettings" />
                </StackPanel>
            </Border>

            <!-- Recent -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{core:T section.recent}" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="RecentEmpty" Text="{core:T recent.empty}" Style="{StaticResource Hint}" />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnRecentClick" Tag="{Binding Name}" Cursor="Hand" Margin="0,2">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F2F2F7" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{core:T section.options}" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="ExplorerBox" Content="{core:T opt.openExplorer}" Click="OnOptionsChanged" />
                    <CheckBox x:Name="AutostartBox" Content="{core:T opt.autostart}" Click="OnOptionsChanged" />
                    <TextBlock Text="{core:T opt.autostartHint}" Style="{StaticResource Hint}" Margin="22,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{core:T opt.language}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                        <ComboBox x:Name="LanguageBox" Width="140" Margin="10,0,0,0" SelectionChanged="OnLanguageChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock x:Name="CurrentVersionText" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                        <Button x:Name="CheckUpdatesButton" Content="{core:T update.check}" Style="{StaticResource SecondaryButton}"
                                Margin="12,0,0,0" Click="OnCheckUpdates" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,4,0,8" />
        </StackPanel>
    </ScrollViewer>
</Window>
