<Window x:Class="PocketDrop.UI.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PocketDrop.Core"
        Title="{core:T confirm.title}" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" ShowActivated="True"
        WindowStartupLocation="Manual">
    <Border Background="{StaticResource PopupBg}" CornerRadius="16" Margin="12" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/PocketDrop;component/Assets/app.png" Width="40" Height="40" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{core:T confirm.title}" Foreground="{StaticResource PopupText}"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="BodyText" Foreground="{StaticResource PopupText}" FontSize="13" Margin="0,3,0,0" />
                    <TextBlock x:Name="ViaText" Foreground="{StaticResource PopupTextSecondary}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="#2C2C2E" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="FolderLabel" Foreground="{StaticResource PopupTextSecondary}" FontSize="11.5" />
                    <TextBlock x:Name="FolderText" Foreground="{StaticResource PopupText}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,8" />
                    <ItemsControl x:Name="FileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource PopupTextSecondary}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DeclineButton" Content="{core:T confirm.decline}" Style="{StaticResource PopupSecondaryButton}"
                        Click="OnDecline" IsCancel="True" />
                <Button x:Name="AcceptButton" Grid.Column="2" Content="{core:T confirm.accept}" Style="{StaticResource PrimaryButton}"
                        Click="OnAccept" IsDefault="True" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
