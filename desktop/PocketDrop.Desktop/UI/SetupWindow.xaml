<Window x:Class="PocketDrop.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PocketDrop.Core"
        Title="PocketDrop" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        Icon="pack://application:,,,/PocketDrop;component/Assets/app.ico">
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/PocketDrop;component/Assets/app.png" Width="52" Height="52" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{core:T setup.title}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock Text="{core:T setup.subtitle}" Style="{StaticResource Hint}" FontSize="13" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{core:T setup.btQuestion}" Style="{StaticResource CardTitle}" Margin="0,24,0,8" />

        <RadioButton x:Name="BtYes" GroupName="bt" Margin="0,0,0,8" Cursor="Hand">
            <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="2"
                            CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{core:T setup.btYes}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{core:T setup.btYesHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="#EEF5FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </RadioButton.Template>
        </RadioButton>

        <RadioButton x:Name="BtNo" GroupName="bt" Cursor="Hand">
            <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="2"
                            CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{core:T setup.btNo}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{core:T setup.btNoHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="#EEF5FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </RadioButton.Template>
        </RadioButton>

        <TextBlock x:Name="AdapterText" Style="{StaticResource Hint}" Margin="2,8,0,0" />

        <TextBlock Text="{core:T setup.folderQuestion}" Style="{StaticResource CardTitle}" Margin="0,22,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="{core:T folder.change}" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Click="OnBrowse" />
        </Grid>
        <TextBlock Text="{core:T folder.hint}" Style="{StaticResource Hint}" Margin="2,6,0,0" />

        <CheckBox x:Name="AutostartBox" Content="{core:T opt.autostart}" IsChecked="True" Margin="0,18,0,0" FontWeight="SemiBold" />
        <TextBlock Text="{core:T opt.autostartHint}" Style="{StaticResource Hint}" Margin="22,2,0,0" />

        <Button Content="{core:T setup.finish}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                Margin="0,26,0,0" Padding="22,9" FontSize="14" Click="OnFinish" IsDefault="True" />
    </StackPanel>
</Window>
