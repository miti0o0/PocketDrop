<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool: the PC receiver without UI, auto-accepting every offer. Used by the
       Android end-to-end test (android/app/src/test/.../EndToEndTest.kt). Never ship this. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketDrop.Desktop\PocketDrop.Desktop.csproj" />
  </ItemGroup>

</Project>
